[Desktop Entry]
Type=Application
Name=Zulip Tray
Exec=/usr/bin/zulip-tray %u
Icon=zulip-tray
Comment=Zulip notification tray icon
Categories=Network;InstantMessaging;
Terminal=false
StartupNotify=false
MimeType=x-scheme-handler/zulip;
Actions=search;

[Desktop Action search]
Name=Find person
Name[de]=Person suchen
Name[fr]=Rechercher une personne
Name[it]=Cerca persona
Name[es]=Buscar persona
Exec=/usr/bin/zulip-tray --search
